# Phish.net API key — request one at https://phish.net/api/keys (log into your free Phish.net account first)
PHISHNET_API_KEY=

# Truth Social bearer token for the bot account.
# Get it: log into truthsocial.com as the bot account -> DevTools -> Network ->
# click any /api/ request -> copy the Authorization header value after "Bearer ".
TRUTH_BEARER_TOKEN=

# X (Twitter) OAuth 1.0a user-context credentials for the bot account.
# Create at https://developer.x.com (Project + App). IMPORTANT: set the App's
# user-auth permissions to Read AND Write BEFORE generating the access token,
# or posts return 403 (regenerate the token after switching to Read+Write).
# Billing is pay-per-use (~$0.015 per link-free post); the bot never posts links.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# phishpicks.net structured song-ingest endpoint.
# Bearer token for POST /api/ingest/song. This destination receives one JSON
# record per song ({"song","set"}) — NOT the composed social text, and ONLY
# the per-song kind (no recaps / show-start / lengths). Set values are
# phish.net's raw labels: "1","2","3" and "e" for the encore.
PHISHPICKS_TOKEN=
# Optional override; defaults to https://phishpicks.net/api/ingest/song
PHISHPICKS_INGEST_URL=

# Comma-separated platforms to post to: truthsocial, x, phishpicks
# (all three: truthsocial,x,phishpicks)
# Only add a NEW platform BETWEEN shows: the idempotency log is per-platform,
# so enabling it mid-show would re-send the whole setlist-so-far to it.
PLATFORMS=truthsocial

# SQLite state file location
STATE_DB=botstate.db
