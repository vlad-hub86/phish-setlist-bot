# Phish.net API key — request one at https://phish.net/api/keys (log into your free Phish.net account first)
PHISHNET_API_KEY=

# Truth Social bearer token for the bot account.
# Get it: log into truthsocial.com as the bot account -> DevTools -> Network ->
# click any /api/ request -> copy the Authorization header value after "Bearer ".
TRUTH_BEARER_TOKEN=

# X (Twitter) OAuth 1.0a user-context credentials for the bot account.
# Create at https://developer.x.com (Project + App). IMPORTANT: set the App's
# user-auth permissions to Read AND Write BEFORE generating the access token,
# or posts return 403 (regenerate the token after switching to Read+Write).
# Billing is pay-per-use (~$0.015 per link-free post); the bot never posts links.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Comma-separated platforms to post to: truthsocial, x  (both: truthsocial,x)
# Only add "x" BETWEEN shows: the idempotency log is per-platform, so enabling
# x mid-show would repost the whole setlist-so-far to X.
PLATFORMS=truthsocial

# SQLite state file location
STATE_DB=botstate.db
